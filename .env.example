# Copiá este archivo como ".env" y completá los valores
# El archivo .env NUNCA se sube a GitHub (agregalo al .gitignore)

# Clave secreta para firmar los tokens JWT
# Generá una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-segura

# Cuántos minutos dura la sesión antes de expirar (10080 = 7 días)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# URL de la base de datos (SQLite guarda todo en un archivo .db)
DATABASE_URL=sqlite:///./taskboard.db